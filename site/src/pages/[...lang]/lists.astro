---
import Base from "../../layouts/Base.astro";
import { lists, describe, type Entry } from "../../lib/data";
import { t, localePath, langFromParams, staticLangs } from "../../lib/i18n";
export const getStaticPaths = staticLangs;
const lang = langFromParams(Astro.params);
---
<Base title={`${t(lang, "lists")} · Awesome Jev`} description={t(lang, "listsLede")} lang={lang} path="/lists/">
  <p class="crumbs"><a href={localePath(lang, "/")}>{t(lang, "home")}</a> / <span>{t(lang, "lists")}</span></p>
  <h1>{t(lang, "lists")}</h1>
  <p class="lede">{t(lang, "listsLede")}</p>
  <div class="rows">
    {lists.map((e: Entry) => (
      <div class="row">
        <div>
          <a href={e.url} rel="noopener"><b>{e.name}</b></a>
          <p>{describe(e, lang)}</p>
        </div>
        <a class="btn" href={e.url} rel="noopener">{t(lang, "source")}</a>
      </div>
    ))}
  </div>
</Base>
