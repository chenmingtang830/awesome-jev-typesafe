---
import Base from "../../../layouts/Base.astro";
import Card from "../../../components/Card.astro";
import { categories, bySection, describe, type Entry } from "../../../lib/data";
import { t, sect, localePath, langFromParams, locales } from "../../../lib/i18n";

export function getStaticPaths() {
  const langs = [undefined, ...locales.filter((l) => l !== "en")];
  return langs.flatMap((lang) => categories.map((s) => ({ params: { lang, slug: s.slug }, props: { name: s.name, image: s.image, subs: s.subs } })));
}

const lang = langFromParams(Astro.params);
const { name, image, subs } = Astro.props as { name: string; image: string | null; subs: string[] };
const all = bySection(name);
const loose = all.filter((e: Entry) => !e.subsection);
const groups = subs.map((sub) => [sub, all.filter((e: Entry) => e.subsection === sub)] as const).filter(([, list]) => list.length);
const title = `${sect(lang, name)} · Awesome Jev`;
const desc = t(lang, "entriesCount", { n: all.length }) + " · " + sect(lang, name);

const jsonld = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name,
  numberOfItems: all.length,
  itemListElement: all.map((e: Entry, i: number) => ({ "@type": "ListItem", position: i + 1, name: e.name, url: e.url, description: e.description })),
};
---
<Base title={title} description={desc} lang={lang} path={`/c/${Astro.params.slug}/`} jsonld={jsonld}>
  <p class="crumbs"><a href={localePath(lang, "/")}>{t(lang, "home")}</a> / <span>{sect(lang, name)}</span></p>
  <h1>{sect(lang, name)}</h1>
  <p class="muted num">{t(lang, "entriesCount", { n: all.length })}</p>
  {image && <div class="detail-banner"><img src={`/media/${image.replace(/^media\//, "")}`} alt="" width="1200" height="600" loading="lazy" /></div>}
  {lang !== "en" && <p class="micro">{t(lang, "generated")}</p>}

  {loose.length > 0 && <div class="grid">{loose.map((e: Entry) => <Card e={e} lang={lang} />)}</div>}

  {groups.map(([sub, list]) => (
    <>
      <div class="rule" id={sub.toLowerCase().replace(/[^a-z0-9]+/g, "-")}><h2>{sect(lang, sub)}</h2><span class="num muted">{list.length}</span></div>
      <div class="grid">{list.map((e: Entry) => <Card e={e} lang={lang} />)}</div>
    </>
  ))}
</Base>
