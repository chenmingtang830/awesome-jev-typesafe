---
import Base from "../../layouts/Base.astro";
import { repoText } from "../../lib/data";
import { t, localePath, langFromParams, staticLangs } from "../../lib/i18n";
import "../../styles/pages.css";
export const getStaticPaths = staticLangs;
const lang = langFromParams(Astro.params);

const REPO = "https://github.com/valentynkit/awesome-jev-typesafe";
const ENTRY = "- [name](https://github.com/owner/name) - One sentence, uppercase start, period end.";
const BADGE = "[![Listed in Awesome Jev](https://awesomejev.vercel.app/badge.svg)](https://awesomejev.vercel.app)";

/** The bar lives in contributing.md; read it here so the two never drift apart. */
const bar = (() => {
  const body = repoText("contributing.md").split("\n## What gets in\n")[1]?.split("\n## ")[0] ?? "";
  const groups: { lead: string; items: string[] }[] = [];
  for (const raw of body.split("\n")) {
    const line = raw.trim();
    if (!line) continue;
    if (line.startsWith("- ")) groups[groups.length - 1]?.items.push(line.slice(2));
    else groups.push({ lead: line, items: [] });
  }
  const kept = groups.filter((g) => g.items.length);
  return kept.length
    ? kept
    : [
        {
          lead: "An entry must:",
          items: [
            "Actually call the Jev API, or be a documented replica of the System One interface on open models. A router or classifier that merely resembles the pattern does not count.",
            "Be public, have a readme that explains what it does, and not be archived.",
          ],
        },
        {
          lead: "And meet at least one of:",
          items: [
            "Listed in five or more other Jev lists.",
            "Twenty or more stars.",
            "Fills a gap in a category nobody else covers.",
            "Publishes measured numbers (accuracy, latency, cost) with a method someone else could repeat.",
          ],
        },
      ];
})();
---
<Base title={`${t(lang, "submitTitle")} · Awesome Jev`} description={t(lang, "submitLede")} lang={lang} path="/submit/">
  <p class="crumbs"><a href={localePath(lang, "/")}>{t(lang, "home")}</a> / <span>{t(lang, "submit")}</span></p>
  <h1>{t(lang, "submitTitle")}</h1>
  <p class="lede">{t(lang, "submitLede")}</p>

  <div class="routes">
    <a class="route" href={`${REPO}/issues/new?template=add-project.yml`}>
      <span class="micro">01</span>
      <h2>{t(lang, "submitIssue")}</h2>
      <p>Answer six fields and a maintainer writes the line for you. Best if you would rather not touch the readme.</p>
      <span class="route-go micro">github.com/issues/new</span>
    </a>
    <a class="route" href={`${REPO}/edit/main/readme.md`}>
      <span class="micro">02</span>
      <h2>{t(lang, "submitPr")}</h2>
      <p>Edit the readme in the browser, add one bullet at the bottom of the most specific section, open the pull request.</p>
      <code class="fmt">{ENTRY}</code>
      <span class="route-go micro">edit/main/readme.md</span>
    </a>
  </div>

  <div class="rule"><h2>{t(lang, "submitBar")}</h2></div>
  <div class="bar-lists">
    {bar.map((g) => (
      <section class="panel bar-card">
        <p class="micro">{g.lead}</p>
        <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
      </section>
    ))}
  </div>

  <div class="rule"><h2>{t(lang, "submitBadge")}</h2></div>
  <section class="panel badge-card">
    <img src="/badge.svg" width="176" height="20" alt="Listed in Awesome Jev" />
    <div class="install">
      <code id="badge-md">{BADGE}</code>
      <button class="btn" type="button" id="copy-badge" data-copied={t(lang, "copied")}>{t(lang, "copyBadge")}</button>
    </div>
  </section>

  <p class="thanks">Thanks for keeping the list worth reading. Everything else lives in <a href={REPO}>the repo</a>.</p>
</Base>
<script>
  const btn = document.getElementById("copy-badge");
  btn?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(document.getElementById("badge-md")?.textContent ?? "");
    const was = btn.textContent;
    btn.textContent = btn.dataset.copied ?? "Copied";
    setTimeout(() => (btn.textContent = was), 1500);
  });
</script>
